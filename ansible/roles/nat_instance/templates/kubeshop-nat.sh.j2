#!/bin/sh
# Gerenciado pelo Ansible (kubeshop-infra). Regras idempotentes de NAT.
set -eu
SUBNET="{{ private_subnet_cidr }}"
IFACE="$(ip route show default | awk '{print $5; exit}')"

sysctl -q -w net.ipv4.ip_forward=1

# Mascaramento da saída da sub-rede privada.
iptables -t nat -C POSTROUTING -s "$SUBNET" -o "$IFACE" -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -s "$SUBNET" -o "$IFACE" -j MASQUERADE

# O Docker coloca a política FORWARD em DROP; a cadeia DOCKER-USER é a forma
# suportada de liberar encaminhamento adicional.
iptables -N DOCKER-USER 2>/dev/null || true
iptables -C FORWARD -j DOCKER-USER 2>/dev/null || iptables -I FORWARD 1 -j DOCKER-USER
iptables -C DOCKER-USER -d "$SUBNET" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
  || iptables -I DOCKER-USER 1 -d "$SUBNET" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables -C DOCKER-USER -s "$SUBNET" -o "$IFACE" -j ACCEPT 2>/dev/null \
  || iptables -I DOCKER-USER 1 -s "$SUBNET" -o "$IFACE" -j ACCEPT

echo "NAT ativo: $SUBNET -> $IFACE"
